{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "baseUrl": ".",
    "paths": {
      "@cutepad/core": ["../../packages/core/src/index.ts"],
      "@cutepad/ui": ["../../packages/ui/src/index.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../../packages/core/src", "../../packages/ui/src"]
}
